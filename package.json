{
  "name": "@mgcrea/bitbucket-cli",
  "version": "0.0.0",
  "description": "A Bitbucket equivalent of GitHub's gh — a typed Bitbucket Cloud client and the `bb` CLI",
  "author": "Olivier Louvignes <olivier@mgcrea.io> (https://github.com/mgcrea)",
  "homepage": "https://github.com/mgcrea/bitbucket-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/bitbucket-cli.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "bb": "./dist/bin/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "cli": "tsx src/bin/cli.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "generate:types:check": "tsx scripts/generate-types.ts --check",
    "lint": "oxlint src/ test/ scripts/",
    "lint:fix": "oxlint --fix src/ test/ scripts/",
    "format": "oxfmt --write src/ test/ scripts/",
    "format:check": "oxfmt --check src/ test/ scripts/",
    "check": "tsc --noEmit",
    "spec": "vitest --run",
    "spec:live": "BB_LIVE_TEST=1 vitest --run test/smoke",
    "coverage": "vitest --run --coverage",
    "watch": "vitest",
    "test": "pnpm run lint && pnpm run check && pnpm run spec && pnpm run format:check",
    "release": "release-it",
    "prepublishOnly": "pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "jq-wasm": "^3.0.0-jq-1.8.2"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "citty": "^0.2.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "release-it": "^21.0.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
